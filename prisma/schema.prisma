// Sistema de Ordens de Serviço — Terrinha e filho funilaria e pintura
// Atividade de extensão universitária

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StatusServico {
  ORCAMENTO
  APROVADO
  EM_EXECUCAO
  PRONTO
  ENTREGUE
  RECUSADO
  CANCELADO
}

enum StatusPagamento {
  NAO_PAGO
  SINAL_PAGO
  PAGO
}

enum PapelUsuario {
  ADMIN
  OPERADOR
}

model Usuario {
  id              String       @id @default(cuid())
  nome            String
  email           String       @unique
  emailVerificado Boolean      @default(false)
  imagem          String?
  papel           PapelUsuario @default(OPERADOR)
  criadoEm        DateTime     @default(now())
  atualizadoEm    DateTime     @default(now()) @updatedAt

  sessoes    Sessao[]
  contas     Conta[]
  historicos HistoricoStatus[]
}

model Cliente {
  id           String   @id @default(cuid())
  nome         String
  telefone     String
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  veiculos Veiculo[]

  @@index([nome])
}

model Veiculo {
  id           String   @id @default(cuid())
  placa        String   @unique
  modelo       String
  cor          String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Restrict)

  ordens OrdemServico[]

  @@index([clienteId])
}

model OrdemServico {
  id               String          @id @default(cuid())
  numero           Int             @unique @default(autoincrement())
  descricaoServico String
  valorOrcamento   Decimal?        @db.Decimal(10, 2)
  valorSinal       Decimal?        @db.Decimal(10, 2)
  statusServico    StatusServico   @default(ORCAMENTO)
  statusPagamento  StatusPagamento @default(NAO_PAGO)
  dataEntrada      DateTime        @default(now())
  previsaoEntrega  DateTime?
  dataEntrega      DateTime?
  observacoes      String?
  criadoEm         DateTime        @default(now())
  atualizadoEm     DateTime        @updatedAt

  veiculoId String
  veiculo   Veiculo @relation(fields: [veiculoId], references: [id], onDelete: Restrict)

  historicos HistoricoStatus[]

  @@index([statusServico])
  @@index([veiculoId])
  @@index([dataEntrada])
}

model HistoricoStatus {
  id             String         @id @default(cuid())
  statusAnterior StatusServico?
  statusNovo     StatusServico
  observacao     String?
  criadoEm       DateTime       @default(now())

  ordemServicoId String
  ordemServico   OrdemServico @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([ordemServicoId, criadoEm])
}

// ─────────────────────────────────────────────────────────────
// Tabelas de autenticação (Better Auth)
// Os campos seguem os nomes em inglês esperados pela biblioteca.
// ─────────────────────────────────────────────────────────────

model Sessao {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId  String
  usuario Usuario @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Conta {
  id                    String    @id
  accountId             String
  providerId            String
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId  String
  usuario Usuario @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verificacao {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}