# Copie este arquivo para .env e preencha os valores.
# O arquivo .env nunca deve ir para o Git.

# Endereço do banco PostgreSQL no Neon.
# Mantenha sslmode=verify-full (valida o certificado do servidor).
DATABASE_URL="postgresql://USUARIO:SENHA@HOST/BANCO?sslmode=verify-full"

# Chave secreta do Better Auth (assina os cookies de sessão).
# Gere direto para a área de transferência, sem exibir na tela:
# node -e "process.stdout.write(require('crypto').randomBytes(32).toString('base64'))" | Set-Clipboard
BETTER_AUTH_SECRET=""

# Endereço base da aplicação.
BETTER_AUTH_URL="http://localhost:3000"